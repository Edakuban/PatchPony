{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchpony.dev/schemas/project/v1/patchpony-project.schema.json",
  "title": "PatchPony project manifest",
  "description": "Version 1 of .patchpony/project.yaml. It declares a read-only project boundary and contains no executable commands or credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "repository", "paths"],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Manifest format version."
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$",
          "description": "Stable, lower-case project identifier."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remoteUrl", "defaultBranch"],
      "properties": {
        "remoteUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^(https://|ssh://)",
          "maxLength": 2000,
          "description": "Canonical remote URL. Local file paths are not allowed."
        },
        "defaultBranch": {
          "type": "string",
          "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,255}$"
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readable", "writable", "forbidden"],
      "properties": {
        "readable": {
          "$ref": "#/$defs/pathGlobs",
          "minItems": 1
        },
        "writable": {
          "$ref": "#/$defs/pathGlobs",
          "description": "Reserved for later iterations. I3 keeps the base checkout read-only regardless of this value."
        },
        "forbidden": {
          "$ref": "#/$defs/pathGlobs",
          "minItems": 1
        }
      }
    }
  },
  "$defs": {
    "pathGlobs": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._*?/-]+$"
      }
    }
  }
}
