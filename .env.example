# Copy this file to .env and provide the values locally. Never commit .env.
POSTGRES_DB=patchpony
POSTGRES_USER=patchpony
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
# HTTPS is the only published Gateway entry point in local Compose.
GATEWAY_HTTPS_PORT=8443
# Local Compose only: enables Swagger under https://localhost:8443/swagger.
PATCHPONY_ASPNETCORE_ENVIRONMENT=Development

# destination.one / OpenAI-compatible model provider
PATCHPONY__AI__ENDPOINT=
PATCHPONY__AI__APIKEY=
PATCHPONY__AI__MODEL=gpt-oss:20b

# Local development only. Do not use this authentication mode in production.
PATCHPONY__AUTH__DEVELOPMENTPASSWORD=
# Production OIDC/JWT configuration. These are identifiers/URLs, not secrets.
PATCHPONY__AUTH__OIDC__AUTHORITY=
PATCHPONY__AUTH__OIDC__AUDIENCE=
PATCHPONY__AUTH__OIDC__REQUIREHTTPSMETADATA=true

# n8n service account. Keep this secret only in .env or a deployment secret store.
PATCHPONY__AUTH__N8N__TOKEN=
PATCHPONY__AUTH__DEVELOPMENTPROJECTS=
PATCHPONY__AUTH__N8N__PROJECTS=patchpony,vocavid,one-data

# Dedicated internal key for authenticated worker queue claims. Base64-encoded random 32 bytes; never reuse auth secrets.
PATCHPONY__WORKER__ID=patchpony-worker-local
PATCHPONY__WORKER__CLAIMSIGNINGKEY=

# Fixed-window flood protection for authenticated API/MCP callers.
PATCHPONY__RATELIMITING__APIPERMITLIMIT=60
PATCHPONY__RATELIMITING__MCPPERMITLIMIT=30
PATCHPONY__RATELIMITING__WINDOWSECONDS=60
PATCHPONY__RATELIMITING__MAXIMUMTRACKEDPARTITIONS=1000
# Browser cross-origin access is disabled by default. Configure only exact trusted UI origins when needed.
# PATCHPONY__CORS__ALLOWEDORIGINS__0=https://console.example.com

# Zoho Projects task comments. Keep the OAuth token local; it needs ZohoProjects.tasks.CREATE.
PATCHPONY__ZOHO__WEBHOOKSECRET=
PATCHPONY__ZOHO__APIBASEURI=
PATCHPONY__ZOHO__PORTALID=hubermedia
PATCHPONY__ZOHO__ACCESSTOKEN=
# Local Open WebUI + n8n test stack. Persistent secrets; never reuse service or provider credentials.
PATCHPONY_LOCAL_N8N_PORT=5678
PATCHPONY_LOCAL_N8N_ENCRYPTION_KEY=
PATCHPONY_LOCAL_OWUI_PORT=3000
PATCHPONY_LOCAL_OWUI_SECRET_KEY=